<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Elections | Campus Vote</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/votehubstyle.css">
</head>

<body class="election-page">

    <!-- ONGOING ELECTIONS -->

    <section class="ongoing-elections" id="ongoing">

        <h3>Ongoing Elections</h3>

        <% const ongoingElections=elections.filter(election=> election.status === "ongoing"); %>

            <% if (ongoingElections.length===0) { %>

                <div class="election-card">
                    <h3>No ongoing elections</h3>
                    <p>There are currently no elections open for voting.</p>
                </div>

                <% } else { %>

                    <% ongoingElections.forEach(election=> { %>

                        <div class="election-card" data-election-id="<%= election._id %>">

                            <h3>
                                <%= election.title %>
                            </h3>

                            <p>
                                <i class="fa-solid fa-circle"></i>
                                Status: <%= election.status %>
                            </p>

                            <p>
                                <i class="fa-solid fa-calendar"></i>
                                <%= election.date %>
                            </p>

                            <p>
                                <i class="fa-solid fa-clock"></i>
                                Voting Ends: <%= election.votingTime %>
                            </p>

                            <a href="/vote/<%= election._id %>" class="vote-now-btn">
                                Vote Now
                            </a>

                            <button class="make-completed-btn" data-election-id="<%= election._id %>">
                                Make Completed
                            </button>

                        </div>

                        <% }) %>

                            <% } %>

    </section>


    <!-- UPCOMING ELECTIONS -->

    <section class="upcoming-elections" id="upcoming">

        <h3>Upcoming Elections</h3>

        <% const upcomingElections=elections.filter(election=> election.status === "upcoming"); %>

            <% if (upcomingElections.length===0) { %>

                <div class="election-card">
                    <h3>No upcoming elections</h3>
                    <p>No upcoming elections are currently scheduled.</p>
                </div>

                <% } else { %>

                    <% upcomingElections.forEach(election=> { %>

                        <div class="election-card" data-election-id="<%= election._id %>">

                            <h3>
                                <%= election.title %>
                            </h3>

                            <p>
                                <i class="fa-solid fa-calendar"></i>
                                Status: <%= election.status %>
                            </p>

                            <p>
                                <i class="fa-solid fa-calendar days"></i>
                                Date: <%= election.date %>
                            </p>

                            <p>
                                <i class="fa-solid fa-clock"></i>
                                Voting: <%= election.votingTime %>
                            </p>

                            <button class="make-ongoing-btn" data-election-id="<%= election._id %>">
                                Make Ongoing
                            </button>

                        </div>

                        <% }) %>

                            <% } %>

    </section>


    <!-- COMPLETED ELECTIONS -->

    <section class="completed-elections" id="completed">

        <h3>Completed Elections</h3>

        <% const completedElections=elections.filter(election=> election.status === "completed"); %>

            <% if (completedElections.length===0) { %>

                <div class="election-card">
                    <h3>No completed elections</h3>
                    <p>Completed elections will appear here.</p>
                </div>

                <% } else { %>

                    <% completedElections.forEach(election=> { %>

                        <div class="election-card" data-election-id="<%= election._id %>">

                            <h3>
                                <%= election.title %>
                            </h3>

                            <p>
                                <i class="fa-solid fa-circle-check"></i>
                                Status: <%= election.status %>
                            </p>

                            <p>
                                <i class="fa-solid fa-calendar"></i>
                                Election Date: <%= election.date %>
                            </p>

                            <p>
                                <i class="fa-solid fa-clock"></i>
                                Voting Time: <%= election.votingTime %>
                            </p>

                            <p>
                                Election completed successfully
                            </p>

                        </div>

                        <% }) %>

                            <% } %>

    </section>


    <!-- ELECTION CALENDAR -->

    <section class="election-calendar" id="calendar">

        <h3>Election Calendar</h3>

        <% if (elections.length===0) { %>

            <div class="calendar-event">

                <h3>No elections scheduled</h3>

                <p>
                    Election dates will appear here once elections are created.
                </p>

            </div>

            <% } else { %>

                <% elections.forEach(election=> { %>

                    <div class="calendar-event">

                        <h3>
                            <%= election.title %>
                        </h3>

                        <p>
                            <i class="fa-solid fa-calendar"></i>
                            <%= election.date %>
                        </p>

                        <p>
                            <i class="fa-solid fa-check"></i>
                            Voting Day
                        </p>

                    </div>

                    <% }) %>

                        <% } %>

    </section>


    <script src="/election.js"></script>

</body>

</html>