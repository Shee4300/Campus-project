<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Vote - <%= election.title %>
    </title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/votehubstyle.css">
</head>

<body class="create-vote-page">

    <div class="vote-container">

        <div class="vote-header">

            <i class="fa-solid fa-box-ballot"></i>

            <h1>
                <%= election.title %>
            </h1>

            <p>
                Select your candidate and submit your vote
            </p>

        </div>


        <form id="vote-form" data-election-id="<%= election._id %>">

            <% candidates.forEach(candidate=> { %>

                <div class="candidate-option">

                    <label>

                        <input type="radio" name="candidate" value="<%= candidate._id %>" required>

                        <span>
                            <%= candidate.name %>
                        </span>

                    </label>

                    <p>
                        Position: <%= candidate.position %>
                    </p>

                </div>

                <% }) %>


                    <button type="submit">
                        Submit Vote
                    </button>

        </form>

    </div>


    <script src="/election.js"></script>

</body>

</html>