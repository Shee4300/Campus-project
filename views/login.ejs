<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Vote - Login</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/votehubstyle.css">
</head>

<body class="login-page">

    <form id="login-form">

        <div class="upper">
            <div class="logo-badge">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div class="icons">
                <h3>Campus <span>Vote</span></h3>
                <p>Smart Elections, Strong Campus</p>
            </div>
        </div>

        <div class="start-vote">
            <h2>Start the Vote</h2>
            <p>Login to your account and make your voice count</p>
        </div>

        <div class="form-group">
            <label for="login">Email</label>

            <div class="login-box">
                <i class="fa-solid fa-envelope"></i>
                <input type="email" id="login" name="login" placeholder="Enter your email-id">
            </div>
        </div>

        <div class="form-group">
            <label for="password">Password</label>

            <div class="password-box">
                <i class="fa-solid fa-lock"></i>
                <input type="password" id="password" name="password" placeholder="Enter your password">
                <i class="fa-solid fa-eye toggle-eye"></i>
            </div>
        </div>

        <div class="paragraph">
            <a href="#">
                Forgot your Password?
            </a>
        </div>

        <div class="login-button">
            <button type="submit">Login</button>
        </div>

        <div class="or">
            <span>OR</span>
        </div>

        <div class="complete">
            <a href="/register" class="create-account">
                <i class="fa-solid fa-user-plus"></i>
                Create Account
            </a>
        </div>

        <div class="expressso">
            <p>
                Be the Change <span>•</span> Your Vote Matters
            </p>
        </div>

    </form>

    <script src="/election.js"></script>

</body>

</html>