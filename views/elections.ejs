<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Elections section</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/votehubstyle.css">
</head>

<body class="election-page">

    <!-- Ongoing Elections -->
    <section class="ongoing-elections" id="ongoing">

        <h3>Ongoing Elections</h3>

        <% elections .filter(election=> election.status === "ongoing")
            .forEach(election => { %>

            <div class="election-card">

                <h3>
                    <%= election.title %>
                </h3>

                <p>
                    <i class="fa-solid fa-circle"></i>
                    Status: <%= election.status %>
                </p>

                <p>
                    <i class="fa-solid fa-calendar days"></i>
                    <%= election.date %>
                </p>

                <p>
                    <i class="fa-solid fa-clock"></i>
                    Voting: <%= election.votingTime %>
                </p>

            </div>

            <% }) %>

    </section>


    <!-- Upcoming Elections -->
    <section class="upcoming-elections" id="upcoming">

        <h3>Upcoming Elections</h3>

        <% elections .filter(election=> election.status === "upcoming")
            .forEach(election => { %>

            <div class="election-card">

                <h3>
                    <%= election.title %>
                </h3>

                <p>
                    <i class="fa-solid fa-calendar"></i>
                    Status: <%= election.status %>
                </p>

                <p>
                    <i class="fa-solid fa-calendar days"></i>
                    Date: <%= election.date %>
                </p>

                <p>
                    <i class="fa-solid fa-clock"></i>
                    Voting: <%= election.votingTime %>
                </p>

            </div>

            <% }) %>

    </section>


    <!-- Completed Elections -->
    <section class="completed-elections" id="completed">

        <h3>Completed Elections</h3>

        <% elections .filter(election=> election.status === "completed")
            .forEach(election => { %>

            <div class="election-card">

                <h3>
                    <%= election.title %>
                </h3>

                <p>
                    Status: <%= election.status %>
                </p>

                <p>
                    Election Date: <%= election.date %>
                </p>

                <p>
                    Period: <%= election.votingTime %>
                </p>

                <p>
                    Election completed successfully
                </p>

            </div>

            <% }) %>

    </section>


    <!-- Election Calendar -->
    <section class="election-calendar" id="calendar">

        <h3>Election Calendar</h3>

        <% elections.forEach(election=> { %>

            <div class="calendar-event">

                <h3>
                    <%= election.title %>
                </h3>

                <p>
                    <%= election.date %>
                </p>

                <p>
                    Voting Day
                </p>

            </div>

            <% }) %>

    </section>


    <script src="/election.js"></script>

</body>

</html>