<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Election</title>

    <link rel="stylesheet" href="/votehubstyle.css">
</head>

<body class="create-election-page">

    <div class="create-election-container">

        <h1>Create Election</h1>

        <p class="form-subtitle">
            Create a new campus election
        </p>

        <form class="create-election-form" action="/api/elections" method="POST">

            <div class="election-form-group">
                <label for="title">Election Title</label>

                <input type="text" id="title" name="title" placeholder="Enter election title" required>
            </div>

            <div class="election-form-group">
                <label for="status">Election Status</label>

                <select id="status" name="status" required>
                    <option value="">Select status</option>
                    <option value="ongoing">Ongoing</option>
                    <option value="upcoming">Upcoming</option>
                    <option value="completed">Completed</option>
                </select>
            </div>

            <div class="election-form-group">
                <label for="date">Election Date</label>

                <input type="text" id="date" name="date" placeholder="8 August 2026" required>
            </div>

            <div class="election-form-group">
                <label for="votingTime">Voting Time</label>

                <input type="text" id="votingTime" name="votingTime" placeholder="10 AM - 5 PM" required>
            </div>

            <button type="submit" class="create-election-btn">
                Create Election
            </button>

        </form>

    </div>

</body>

</html>