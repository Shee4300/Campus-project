<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Vote - Resources</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <link rel="stylesheet" href="votehubstyle.css">
</head>

<body class="resource-page">

    <section class="resources" id="resources">

        <h1>Resources</h1>

        <p>
            Explore guides and information about Campus Vote
        </p>


        <div class="resource-container">

            <!-- Documentation -->

            <div class="resource-card" id="documentation">

                <i class="fa-solid fa-book"></i>

                <h2>Documentation</h2>

                <p>
                    Learn about the Campus Vote platform and its features.
                </p>

                <a href="#documentation-info">
                    Read Documentation
                </a>

            </div>


            <!-- Features -->

            <div class="resource-card" id="features">

                <i class="fa-solid fa-list-check"></i>

                <h2>Features</h2>

                <p>
                    Explore the features available in our online voting system.
                </p>

                <a href="#features-info">
                    Explore Features
                </a>

            </div>


            <!-- FAQ -->

            <div class="resource-card" id="FAQ">

                <i class="fa-solid fa-circle-question"></i>

                <h2>FAQ</h2>

                <p>
                    Find answers to frequently asked questions.
                </p>

                <a href="#FAQ-info">
                    Frequently Asked Questions
                </a>

            </div>


            <!-- User Guide -->

            <div class="resource-card" id="userGuide">

                <i class="fa-solid fa-book-open"></i>

                <h2>User Guide</h2>

                <p>
                    Learn how to use the Campus Vote platform.
                </p>

                <a href="#guide-info">
                    Read User Guide
                </a>

            </div>

        </div>

    </section>


    <!-- Documentation -->

    <section class="resource-info" id="documentation-info">

        <h2>Documentation</h2>

        <p>
            Learn about the platform, elections, voting process
            and available features.
        </p>

    </section>


    <!-- Features -->

    <section class="resource-info" id="features-info">

        <h2>Features</h2>

        <p>
            Explore online voting, candidate selection,
            election management and results.
        </p>

    </section>


    <!-- FAQ -->

    <section class="resource-info" id="FAQ-info">

        <h2>Frequently Asked Questions</h2>

        <p>How do I register?</p>

        <p>How can I vote in an election?</p>

        <p>Can I change my vote after submitting?</p>

        <p>How do I know if my vote was submitted?</p>

        <p>Where can I view election results?</p>

    </section>


    <!-- User Guide -->

    <section class="resource-info" id="guide-info">

        <h2>User Guide</h2>

        <h3>How to Vote on Campus Vote</h3>

        <div class="guide-steps">

            <div>
                <strong>1. Register / Login</strong>
                <p>Create your account or log in to your existing account.</p>
            </div>

            <div>
                <strong>2. Choose an Election</strong>
                <p>Select the ongoing election you want to participate in.</p>
            </div>

            <div>
                <strong>3. Select a Candidate</strong>
                <p>Review the candidates and choose your preferred candidate.</p>
            </div>

            <div>
                <strong>4. Cast Your Vote</strong>
                <p>Click on the vote option for your selected candidate.</p>
            </div>

            <div>
                <strong>5. Submit Your Vote</strong>
                <p>Review your selection and submit your vote.</p>
            </div>

            <div>
                <strong>6. Vote Confirmation</strong>
                <p>
                    After submission, you will receive confirmation
                    that your vote has been recorded.
                </p>
            </div>

        </div>

    </section>
    <script src="election.js"></script>
</body>

</html>